# Local-only reference for every runtime environment variable this project
# reads. Names and shapes only -- every value below is an inert local
# placeholder, never a real credential. Real values live only in
# `docker compose` environment blocks (local dev, already-local-only) or the
# deploy platform's own secret store (never in this repo). See README.md
# "Configuration" for what each variable does and how to rotate it.

# --- Django (apps/api) ---
DJANGO_SECRET_KEY=local-development-only-not-a-secret-please-set-a-real-one-in-deploy
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_COOKIES=false
# local | production -- selects the security-header/SILENCED_SYSTEM_CHECKS
# profile in apps/api/config/settings.py; "production" additionally requires
# an HTTPS terminator in front of the service.
DJANGO_DEPLOY_ENV=local

# --- PostgreSQL (shared by api and db) ---
POSTGRES_DB=savepoint_test
POSTGRES_USER=savepoint_test
POSTGRES_PASSWORD=local_test_only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Demo account bootstrap (apps/api, D-02: local-dev-only, never a real
#     account) -- rotate by changing these and re-running
#     `bootstrap_demo_account`, which updates the existing anchored account
#     in place rather than creating a new one. ---
DEMO_USERNAME=demo-visitor
DEMO_PASSWORD=SavePoint-Demo-2026-Visit!

# --- Next.js (apps/web) ---
# Server-side only -- never prefix with NEXT_PUBLIC_, which would ship the
# value to the browser bundle. Same-origin proxy target the browser never
# talks to directly.
API_PROXY_TARGET=http://api:8000
