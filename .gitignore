# Local dependency and test caches
.pnpm-store/
node_modules/
__pycache__/
.pytest_cache/

# Local runtime configuration and credentials
.env
.env.*
!.env.example

# Build and test output
.next/
test-results/
playwright-report/
*.tsbuildinfo

.neon
data/snapshots/

# Offline enrichment evidence JSON (retained next to its corpus_version, never
# committed in bulk -- same rule as data/snapshots/, ADR-006 §4 / ADR-008).
.rawg-evidence*.json
apps/api/.rawg-evidence*.json
**/.rawg-evidence*.json
apps/api/.evaluation-test-run.json

# Editor / agent tooling state (machine- and session-local, not project source)
.gsd/
.planning/milestone.lock
skills-lock.json
.agents/skills/neon*/
.claude/skills/

# Material de referencia de terceros (tesis de ejemplo, plantillas)
thesis/referencias/

